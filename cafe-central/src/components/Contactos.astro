---
import { site, contactos, formulario } from "../config";
const tel = contactos.telefone.replace(/\s/g, "");
---

<section id="contactos" class="contentor pt-20 md:pt-28">
  <h2 class="titulo-seccao">Contactos</h2>

  <div class="mt-8 grid gap-10 lg:grid-cols-2">
    <div class="space-y-8">
      <dl class="grid gap-5 sm:grid-cols-2 font-titulo">
        <div>
          <dt class="text-texto-suave text-sm">Morada</dt>
          <dd class="text-lg font-medium">
            {contactos.morada.rua}<br />{contactos.morada.codigoPostal} {contactos.morada.localidade}
          </dd>
        </div>
        <div>
          <dt class="text-texto-suave text-sm">Telefone</dt>
          <dd class="text-lg font-medium"><a href={`tel:${tel}`} class="hover:underline">{contactos.telefoneVisivel}</a></dd>
          <dd class="text-xs text-texto-suave">Chamada para a rede fixa nacional</dd>
        </div>
        <div class="sm:col-span-2">
          <dt class="text-texto-suave text-sm">Email</dt>
          <dd class="text-lg font-medium"><a href={`mailto:${contactos.email}`} class="hover:underline">{contactos.email}</a></dd>
        </div>
      </dl>

      <!-- Mapa: só carrega depois de o visitante clicar (o Google Maps usa cookies — RGPD) -->
      <div class="mapa relative aspect-[4/3] rounded-2xl overflow-hidden bg-superficie ring-1 ring-linha">
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-6 text-center">
          <p class="text-texto-suave text-sm max-w-xs">
            O mapa é fornecido pelo Google e pode guardar cookies no seu dispositivo.
          </p>
          <div class="flex flex-wrap justify-center gap-2">
            <button type="button" class="botao botao-principal carregar-mapa" data-src={contactos.mapaEmbed}>
              Mostrar mapa
            </button>
            <a href={contactos.mapaLink} target="_blank" rel="noopener" class="botao botao-secundario">
              Abrir no Google Maps
            </a>
          </div>
        </div>
      </div>
    </div>

    {
      formulario.ativo && (
        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="formulario bg-superficie rounded-2xl ring-1 ring-linha p-6 md:p-8 space-y-5 self-start"
        >
          <div>
            <h3 class="font-titulo text-2xl font-bold">Enviar mensagem</h3>
            <p class="text-texto-suave text-base mt-1">Encomendas, reservas para grupos ou outras questões. Respondemos no próprio dia.</p>
          </div>

          <input type="hidden" name="access_key" value={formulario.chaveWeb3Forms} />
          <input type="hidden" name="subject" value={formulario.assunto} />
          <input type="hidden" name="from_name" value={`Site ${site.nome}`} />
          <input type="hidden" name="redirect" value={new URL("/obrigado", site.url).href} />
          <!-- Anti-spam: campo invisível que os bots preenchem -->
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

          <label class="block">
            <span class="font-titulo font-medium">Nome</span>
            <input required name="name" autocomplete="name" class="campo" />
          </label>
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="font-titulo font-medium">Email</span>
              <input required type="email" name="email" autocomplete="email" class="campo" />
            </label>
            <label class="block">
              <span class="font-titulo font-medium">Telefone <span class="text-texto-suave font-normal">(opcional)</span></span>
              <input type="tel" name="phone" autocomplete="tel" class="campo" />
            </label>
          </div>
          <label class="block">
            <span class="font-titulo font-medium">Mensagem</span>
            <textarea required name="message" rows="5" class="campo resize-y" />
          </label>
          <label class="flex gap-3 items-start text-sm text-texto-suave">
            <input required type="checkbox" name="consentimento" value="sim" class="mt-1 size-4 accent-primaria" />
            <span>
              Aceito que os meus dados sejam usados para responder a este pedido, de acordo com a
              <a href="/privacidade" class="underline">política de privacidade</a>.
            </span>
          </label>
          <button type="submit" class="botao botao-principal">Enviar mensagem</button>
          <p class="estado-envio text-sm" role="status" aria-live="polite" />
        </form>
      )
    }
  </div>
</section>

<style>
  .campo {
    display: block;
    width: 100%;
    margin-top: 0.35rem;
    padding: 0.7rem 0.9rem;
    border-radius: 0.6rem;
    background: var(--color-fundo);
    border: 1px solid var(--color-linha);
    font-family: var(--font-texto);
    font-size: 1rem;
  }
  .campo:focus {
    outline: 2px solid var(--color-primaria);
    outline-offset: 1px;
    border-color: transparent;
  }
</style>

<script>
  // Mapa só carrega com o clique do visitante
  document.querySelectorAll<HTMLButtonElement>(".carregar-mapa").forEach((botao) => {
    botao.addEventListener("click", () => {
      const caixa = botao.closest(".mapa")!;
      const iframe = document.createElement("iframe");
      iframe.src = botao.dataset.src!;
      iframe.title = "Mapa com a localização";
      iframe.loading = "lazy";
      iframe.referrerPolicy = "no-referrer-when-downgrade";
      iframe.className = "absolute inset-0 w-full h-full border-0";
      caixa.replaceChildren(iframe);
    });
  });

  // Envio do formulário sem sair da página (se o JS falhar, o envio normal funciona na mesma)
  document.querySelectorAll<HTMLFormElement>(".formulario").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const estado = form.querySelector<HTMLElement>(".estado-envio")!;
      const botao = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      botao.disabled = true;
      estado.textContent = "A enviar...";
      estado.className = "estado-envio text-sm text-texto-suave";
      try {
        const resposta = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        const dados = await resposta.json();
        if (!resposta.ok || !dados.success) throw new Error(dados.message);
        form.reset();
        estado.textContent = "Mensagem enviada. Respondemos assim que possível.";
        estado.className = "estado-envio text-sm text-aberto font-medium";
      } catch {
        estado.textContent = "A mensagem não foi enviada. Tente de novo ou ligue-nos.";
        estado.className = "estado-envio text-sm text-fechado font-medium";
      } finally {
        botao.disabled = false;
      }
    });
  });
</script>
