---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { galeria } from "../config";

// Carrega automaticamente as imagens de src/assets/galeria/
const ficheiros = import.meta.glob<{ default: ImageMetadata }>("../assets/galeria/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
});
const fotos = galeria
  .map((f) => ({ ...f, imagem: ficheiros[`../assets/galeria/${f.ficheiro}`]?.default }))
  .filter((f) => f.imagem);
---

{
  fotos.length > 0 && (
    <section id="galeria" class="contentor pt-20 md:pt-28">
      <h2 class="titulo-seccao">Galeria</h2>
      <ul class="mt-8 columns-2 md:columns-3 gap-3 md:gap-4 [&>li]:mb-3 md:[&>li]:mb-4">
        {fotos.map((f) => (
          <li class="break-inside-avoid">
            <Image
              src={f.imagem!}
              alt={f.alt}
              widths={[400, 700]}
              sizes="(min-width: 768px) 33vw, 50vw"
              class="w-full h-auto rounded-xl"
            />
          </li>
        ))}
      </ul>
    </section>
  )
}
